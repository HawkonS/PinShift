<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/diagnostic_intro"
            android:textSize="15sp" />

        <Button
            android:id="@+id/diagnostic_refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/diagnostic_refresh" />

        <Button
            android:id="@+id/diagnostic_open_mock_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/diagnostic_open_mock_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/diagnostic_device_status"
            android:textStyle="bold"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/diagnostic_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/border_gray"
            android:padding="10dp"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/diagnostic_gps_status"
            android:textStyle="bold"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/diagnostic_gps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/border_gray"
            android:padding="10dp"
            android:text="@string/diagnostic_waiting"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/diagnostic_network_status"
            android:textStyle="bold"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/diagnostic_network"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/border_gray"
            android:padding="10dp"
            android:text="@string/diagnostic_waiting"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/diagnostic_event_log"
            android:textStyle="bold"
            android:textSize="17sp" />

        <Button
            android:id="@+id/diagnostic_clear_log"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diagnostic_clear_log" />

        <TextView
            android:id="@+id/diagnostic_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/border_gray"
            android:fontFamily="monospace"
            android:minHeight="160dp"
            android:padding="10dp"
            android:text="@string/diagnostic_waiting"
            android:textIsSelectable="true"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
