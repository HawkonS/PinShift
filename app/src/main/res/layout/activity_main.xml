<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">

    <include
        layout="@layout/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="@dimen/nav_drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/nav_header_start"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <include
            layout="@layout/nav_header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/nav_header_height" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/nav_content_background"
            android:orientation="vertical">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="24dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="24dp"
                        android:paddingBottom="6dp"
                        android:text="@string/nav_section_features"
                        android:textAllCaps="false"
                        android:textColor="@color/nav_drawer_version"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/nav_history"
                        style="@style/PinShift.NavigationRow">

                        <ImageView
                            style="@style/PinShift.NavigationIcon"
                            app:srcCompat="@drawable/nav_ic_history" />

                        <TextView
                            style="@style/PinShift.NavigationText"
                            android:text="@string/nav_menu_history" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nav_map_key"
                        style="@style/PinShift.NavigationRow">

                        <ImageView
                            style="@style/PinShift.NavigationIcon"
                            app:srcCompat="@drawable/nav_ic_map" />

                        <TextView
                            style="@style/PinShift.NavigationText"
                            android:text="@string/nav_menu_map_key" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nav_diagnostic"
                        style="@style/PinShift.NavigationRow">

                        <ImageView
                            style="@style/PinShift.NavigationIcon"
                            app:srcCompat="@drawable/nav_ic_diagnostic" />

                        <TextView
                            style="@style/PinShift.NavigationText"
                            android:text="@string/nav_menu_diagnostic" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nav_settings"
                        style="@style/PinShift.NavigationRow">

                        <ImageView
                            style="@style/PinShift.NavigationIcon"
                            app:srcCompat="@drawable/nav_ic_settings" />

                        <TextView
                            style="@style/PinShift.NavigationText"
                            android:text="@string/nav_menu_settings" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="22dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="22dp"
                        android:background="@color/nav_drawer_divider" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="24dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="24dp"
                        android:paddingBottom="5dp"
                        android:text="@string/nav_section_system"
                        android:textAllCaps="false"
                        android:textColor="@color/nav_drawer_version"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/nav_dev"
                        style="@style/PinShift.NavigationRowCompact">

                        <ImageView
                            style="@style/PinShift.NavigationIcon"
                            app:srcCompat="@drawable/nav_ic_mock_location" />

                        <TextView
                            style="@style/PinShift.NavigationText"
                            android:text="@string/nav_menu_dev" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="22dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="22dp"
                        android:background="@color/nav_drawer_divider" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="24dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="24dp"
                        android:paddingBottom="5dp"
                        android:text="@string/nav_section_project"
                        android:textAllCaps="false"
                        android:textColor="@color/nav_drawer_version"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/nav_repository"
                        style="@style/PinShift.NavigationRowCompact">

                        <ImageView
                            style="@style/PinShift.NavigationIcon"
                            app:srcCompat="@drawable/nav_ic_repository" />

                        <TextView
                            style="@style/PinShift.NavigationText"
                            android:text="@string/nav_code_repository" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nav_contact"
                        style="@style/PinShift.NavigationRowCompact">

                        <ImageView
                            style="@style/PinShift.NavigationIcon"
                            app:srcCompat="@drawable/nav_ic_contact" />

                        <TextView
                            style="@style/PinShift.NavigationText"
                            android:text="@string/nav_contact_author" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/nav_update"
                        style="@style/PinShift.NavigationRowCompact">

                        <ImageView
                            style="@style/PinShift.NavigationIcon"
                            app:srcCompat="@drawable/nav_ic_update" />

                        <TextView
                            style="@style/PinShift.NavigationText"
                            android:text="@string/nav_check_update" />
                    </LinearLayout>

                </LinearLayout>
            </ScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/nav_drawer_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/nav_disclaimer_footer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/nav_app_notice_body"
                    android:textColor="@color/nav_drawer_text_muted"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/nav_version_footer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:textColor="@color/nav_drawer_version"
                    android:textSize="9sp"
                    tools:text="PinShift · 版本 0.0.2" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
